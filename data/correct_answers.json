      "line_items": [
        {
          "description": "Pest control services - quarterly contract",
          "hsn_sac": "998531",
          "qty": 1,
          "unit": "Quarter",
          "unit_price": 18000,
          "gst_rate": 18,
          "taxable_value": 18000
        },
        {
          "description": "Addl. treatment - canteen area (handwritten)",
          "hsn_sac": null,
          "qty": null,
          "unit": null,
          "unit_price": null,
          "gst_rate": null,
          "taxable_value": 4500
        }
      ],
      "taxable_value": 18000,
      "tax_type": "CGST+SGST",
      "tax": {
        "CGST": 1620.0,
        "SGST": 1620.0
      },
      "total": 26550,
      "bank": {
        "bank_name": "Indian Bank",
        "bank_account": "7041128856",
        "ifsc": "IDIB000A031"
      },
      "has_handwritten_changes": true,
      "handwritten_notes": "Extra line 'Addl. treatment - canteen area 4,500' added by hand; printed grand total Rs 21,240 struck out and 26,550 written by hand; initialled 'revised - S.K. 30/10'."
    }
  },
